# Supabase (server)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional aliases supported by the app:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<service-role-key>

# Existing session secret for app auth cookie
AUTH_SESSION_SECRET=<long-random-secret>

# NexLink Fax API
NEXLINK_API_BASE_URL=https://sandbox-hea.nexlink2.jp
NEXLINK_API_TOKEN=
# Internal Windows SHARP PC-FAX bridge (used when admin selects server mode)
FAX_BRIDGE_URL=http://192.168.1.50:8787
FAX_BRIDGE_TOKEN=<same-token-as-windows-bridge>
# Outbound polling agent. Use the same long random value in the Windows agent config.
DESKTOP_FAX_AGENT_KEY=<long-random-agent-key>
# Optional legacy aliases supported by the app:
# NEXILINK_FAX_ENDPOINT=https://api.nexilink.example/v1/faxes
# NEXILINK_API_KEY=your_nexilink_api_key
# NEXILINK_SENDER_ID=optional_sender_id
