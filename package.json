{
  "name": "fax-mail",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dist": "npm run build:desktop && electron-builder --win",
    "build:desktop": "node -e \"require('fs').mkdirSync('desktop',{recursive:true})\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "csv-parse": "^5.5.0",
    "next": "14.2.3",
    "next-auth": "^5.0.0-beta.30",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "typescript": "6.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.faxmailsystem.desktop",
    "productName": "FAX Mail System",
    "files": [
      "desktop/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
